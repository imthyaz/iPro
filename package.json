{
  "name": "ipro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:shared": "pnpm --filter @ipro/shared build",
    "build": "pnpm -r build",
    "dev": "pnpm build:shared && docker compose up -d --wait && pnpm -r --parallel --filter \"./apps/*\" --filter \"./packages/*\" dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:unit": "pnpm build:shared && pnpm -r test:unit",
    "test:e2e": "pnpm build && pnpm --filter @ipro/web test:e2e",
    "db:migrate": "pnpm --filter @ipro/api db:migrate",
    "db:seed": "pnpm --filter @ipro/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
