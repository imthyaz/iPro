# Local development — copy to .env. Never commit .env.
DATABASE_URL=postgres://ipro:ipro@localhost:5432/ipro
# Integration tests rebuild this database from the migrations on every run.
TEST_DATABASE_URL=postgres://ipro:ipro@localhost:5432/ipro_test
# Synthetic dev tenant created by `pnpm db:seed`.
TENANT_ID=00000000-0000-4000-8000-000000000001
PORT=3000
# Set to false to run the API without starting pg-boss workers (e2e, one-off scripts).
JOBS_ENABLED=true

# Identity (Entra ID). Leave blank locally to use the dev sign-in with synthetic users (refused in production).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Goes through the web origin so the session cookie is set there (Vite proxies /api).
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Sessions end after this many idle hours, and always after this many days.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Field encryption for KYC and compensation: "local" (dev only, refused in production) or "kms".
FIELD_KEY_PROVIDER=local
# Base64 of 32 random bytes, for the local provider only. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_FIELD_KEY=

# AWS (dev account, ap-south-1). Local uses MinIO and a local KMS stub.
AWS_REGION=ap-south-1
S3_BUCKET=ipro-dev-documents
# KMS key that wraps each tenant's field-encryption data key (FIELD_KEY_PROVIDER=kms).
KMS_KEY_ID=
# Local MinIO from docker-compose.yml (throwaway local values). Leave blank in AWS.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=ipro-local
S3_SECRET_ACCESS_KEY=ipro-local-only

# Ask iPro — Bedrock India profile only. IDs MUST start with "in." (enforced at startup).
BEDROCK_MODEL_LOOKUP=in.anthropic.<haiku-model-id>
BEDROCK_MODEL_REASONING=in.anthropic.<sonnet-model-id>

# Microsoft Graph (Teams + mail)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
TEAMS_APP_ID=

# Zoho Sign
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
