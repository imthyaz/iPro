# Local development — copy to .env. Never commit .env.
DATABASE_URL=postgres://ipro:ipro@localhost:5432/ipro
TENANT_ID=ideassion-dev

# Identity (Entra ID). Leave blank locally to use the stub identity provider.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# AWS (dev account, ap-south-1). Local uses MinIO and a local KMS stub.
AWS_REGION=ap-south-1
S3_BUCKET=ipro-dev-documents
KMS_KEY_ID=

# Ask iPro — Bedrock India profile only. IDs MUST start with "in." (enforced at startup).
BEDROCK_MODEL_LOOKUP=in.anthropic.<haiku-model-id>
BEDROCK_MODEL_REASONING=in.anthropic.<sonnet-model-id>

# Microsoft Graph (Teams + mail)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
TEAMS_APP_ID=

# Zoho Sign
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
