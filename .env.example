# Local development — copy to .env. Never commit .env.
DATABASE_URL=postgres://ipro:ipro@localhost:5432/ipro
# Integration tests rebuild this database from the migrations on every run.
TEST_DATABASE_URL=postgres://ipro:ipro@localhost:5432/ipro_test
# Synthetic dev tenant created by `pnpm db:seed`.
TENANT_ID=00000000-0000-4000-8000-000000000001
PORT=3000
# Set to false to run the API without starting pg-boss workers (e2e, one-off scripts).
JOBS_ENABLED=true

# Identity (Entra ID). Leave blank locally to use the dev sign-in with synthetic users (refused in production).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Goes through the web origin so the session cookie is set there (Vite proxies /api).
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Sessions end after this many idle hours, and always after this many days.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Field encryption for KYC and compensation: "local" (dev only, refused in production) or "kms".
FIELD_KEY_PROVIDER=local
# Base64 of 32 random bytes, for the local provider only. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_FIELD_KEY=

# AWS (dev account, ap-south-1). Locally: SeaweedFS for S3 and LOCAL_FIELD_KEY instead of KMS.
AWS_REGION=ap-south-1
S3_BUCKET=ipro-dev-documents
# KMS key that wraps each tenant's field-encryption data key (FIELD_KEY_PROVIDER=kms).
KMS_KEY_ID=
# Documents: "s3" (AWS S3, or SeaweedFS locally) or "memory" (tests only; refused in production).
STORAGE_PROVIDER=s3
# Local SeaweedFS from docker-compose.yml (throwaway local values). Leave blank in AWS (task role).
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=ipro-local
S3_SECRET_ACCESS_KEY=ipro-local-only

# Ask iPro — Bedrock India profile only. IDs MUST start with "in." (enforced at startup).
BEDROCK_MODEL_LOOKUP=in.anthropic.<haiku-model-id>
BEDROCK_MODEL_REASONING=in.anthropic.<sonnet-model-id>

# Microsoft Graph (Teams + mail; pre-joiner guest invitations, decision #55). Created by the account owner.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# "fake" locally (creates a dev sign-in user for the joiner); "graph" in AWS (refused as fake in production).
INVITES_PROVIDER=fake
# Entra group for pre-joiners, mapped to the employee role.
PREJOINER_GROUP_ID=
APP_URL=http://localhost:5173
TEAMS_APP_ID=

# E-signature: "fake" locally (letters sign in-app for testing) or "zoho" (refused in production: fake).
ESIGN_PROVIDER=fake
# Zoho Sign, India data centre. Created by the account owner; kept in Secrets Manager in AWS.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SIGN_URL=https://sign.zoho.in
# Shared secret for webhook signatures (HMAC-SHA256, base64) and the header Zoho sends it in.
ZOHO_SIGN_WEBHOOK_SECRET=
ZOHO_SIGN_WEBHOOK_HEADER=X-ZS-WEBHOOK-SIGNATURE
