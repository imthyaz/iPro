{
  "name": "@ipro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/db/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@ipro/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "drizzle-orm": "0.45.4",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
